{
  "schemaVersion": 1,
  "id": "donovan.workspaces",
  "name": "Workspaces",
  "version": "0.5.0",
  "author": "Donovan Burbano",
  "license": "MIT",
  "description": "Animated workspace groups with open application icons for the Omarchy bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Workspaces.qml"
  },
  "omarchy": {
    "clonedFrom": "omarchy.workspaces"
  },
  "barWidget": {
    "displayName": "Workspaces",
    "description": "Workspace numbers, app icons, and an animated active highlight.",
    "category": "Compositor",
    "allowMultiple": false,
    "defaultSection": "left",
    "defaults": {
      "persistentWorkspaces": 5,
      "showNumbers": true,
      "animations": true,
      "scrollToSwitch": true,
      "showAppIcons": true,
      "maxAppIcons": 3,
      "showBackground": false
    },
    "schema": [
      {
        "key": "persistentWorkspaces",
        "type": "integer",
        "label": "Persistent workspaces",
        "defaultValue": 5,
        "min": 1,
        "max": 20,
        "step": 1
      },
      {
        "key": "showNumbers",
        "type": "boolean",
        "label": "Show numbers",
        "defaultValue": true
      },
      {
        "key": "animations",
        "type": "boolean",
        "label": "Animate indicator",
        "defaultValue": true
      },
      {
        "key": "scrollToSwitch",
        "type": "boolean",
        "label": "Scroll to switch",
        "defaultValue": true
      },
      {
        "key": "showAppIcons",
        "type": "boolean",
        "label": "Show application icons",
        "defaultValue": true
      },
      {
        "key": "maxAppIcons",
        "type": "integer",
        "label": "Maximum icons per workspace",
        "defaultValue": 3,
        "min": 1,
        "max": 8,
        "step": 1
      },
      {
        "key": "showBackground",
        "type": "boolean",
        "label": "Show group background",
        "defaultValue": false
      }
    ]
  }
}
